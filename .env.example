# Public Frontend Configuration
VITE_PUBLIC_BUILDER_KEY=your_builder_api_key
PING_MESSAGE="ping pong"

# API Base URL - Production Power Pages Portal
VITE_PUBLIC_API_BASE_URL=https://your-org.powerappsportals.com/

# ============================================================================
# Azure AD Authentication - Server-side (Client Credentials Flow)
# Used by the server to authenticate with Dataverse/Power Apps APIs
# ============================================================================

# Azure AD Tenant ID
# Get from: Azure Portal > Azure Active Directory > Properties > Directory ID
AZURE_TENANT_ID=your-tenant-id-here

# Azure AD Application (Client) ID
# Get from: Azure Portal > App Registrations > Your App > Application ID
AZURE_CLIENT_ID=your-client-id-here

# Azure AD Application (Client) Secret
# Get from: Azure Portal > App Registrations > Your App > Certificates & secrets
# SECURITY: Never commit this to version control!
# Recommended: Set this via environment variable or CI/CD secrets
AZURE_CLIENT_SECRET=your-client-secret-here

# Azure AD Token Endpoint
# Format: https://login.microsoftonline.com/{TENANT_ID}/oauth2/v2.0/token
TOKEN_URL=https://login.microsoftonline.com/your-tenant-id-here/oauth2/v2.0/token

# Dataverse Organization Resource URL
# Get from: Power Apps > Settings > Organization > Organization URL
# Format: https://{org}.crm{region}.dynamics.com/.default
DATAVERSE_RESOURCE=https://your-org.crm15.dynamics.com/.default

# ============================================================================
# Optional: Power Apps Basic Auth (Fallback - not recommended)
# Only used if Azure AD is unavailable
# ============================================================================

# POWER_APPS_USERNAME=your_username
# POWER_APPS_PASSWORD=your_password

# ============================================================================
# Optional: Configuration Flags
# ============================================================================

# Forward client's Authorization header instead of using server credentials
FORWARD_CLIENT_AUTH=true

# ============================================================================
# B2C Configuration (Optional)
# ============================================================================

# B2C Client ID (for client-side OAuth flows)
VITE_B2C_CLIENT_ID=your-b2c-client-id

# B2C Token URL
VITE_B2C_TOKEN_URL=https://login.microsoftonline.com/your-tenant-id/oauth2/token

# B2C Scopes
VITE_B2C_SCOPES=openid offline_access

# B2C Client Secret (NEVER commit - use environment variable instead)
# VITE_B2C_CLIENT_SECRET=your-b2c-client-secret

# ============================================================================
# Setup Instructions
# ============================================================================
#
# 1. Copy this file to .env
#    $ cp .env.example .env
#
# 2. Get Azure AD credentials:
#    - Go to https://portal.azure.com
#    - Select Azure Active Directory
#    - Go to App Registrations
#    - Create or select your application
#    - Copy the required IDs and create a client secret
#
# 3. Get Dataverse details:
#    - Log into Power Apps (https://make.powerapps.com)
#    - Select your environment
#    - Go to Settings > Organization
#    - Copy the Organization URL
#
# 4. For development, you can set secrets as environment variables:
#    
#    Windows PowerShell:
#    $env:AZURE_CLIENT_SECRET = "your-secret"
#    npm run dev
#
#    macOS/Linux:
#    AZURE_CLIENT_SECRET=your-secret npm run dev
#
# 5. For production/CI-CD:
#    - Never commit secrets to version control
#    - Use CI/CD pipeline secret management
#    - Set secrets in your hosting platform's environment variables
#
# ============================================================================
