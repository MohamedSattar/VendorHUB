# Public Frontend Configuration
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# API Base URL - Production Power Pages Portal
VITE_PUBLIC_API_BASE_URL=https://ecavendorhubspa.powerappsportals.com/
# ============================================================================
# Azure AD Authentication - Server-side (Client Credentials Flow)
# Used by the server to authenticate with Dataverse/Power Apps APIs
# ============================================================================
# Azure AD Tenant ID
# Get this from Azure AD > Properties > Directory (Tenant) ID
AZURE_TENANT_ID=9bfb065d-cde3-4be3-8515-0b1c8fe6fc29

# Azure AD Application (Client) ID
# Get this from Azure AD > App Registrations > Your App > Application (client) ID
AZURE_CLIENT_ID=02b145a5-cc87-408e-8333-71b77ce1d8c2

# Azure AD Application (Client) Secret
# Get this from Azure AD > App Registrations > Your App > Certificates & secrets
# WARNING: DO NOT COMMIT THIS TO GIT - Use CI/CD secrets or environment variable instead
AZURE_CLIENT_SECRET=yGu8Q~Ks0XIGCABfHaeJtfMnSlI8yY_2ejRgMczc

# Azure AD Token Endpoint (OAuth 2.0 v2.0)
# Format: https://login.microsoftonline.com/{TENANT_ID}/oauth2/v2.0/token
TOKEN_URL=https://login.microsoftonline.com/9bfb065d-cde3-4be3-8515-0b1c8fe6fc29/oauth2/v2.0/token

# Dataverse Resource URL
# Format: https://{org}.crm{region}.dynamics.com/.default
# Get the organization URL from your Power Apps environment
DATAVERSE_RESOURCE=https://org8b20ca8a.crm15.dynamics.com/.default

# ============================================================================
# Optional: Power Apps Basic Auth Credentials (Fallback only)
# Only used if Azure AD authentication is unavailable
# WARNING: DO NOT USE IN PRODUCTION - Use Azure AD instead
# ============================================================================

# POWER_APPS_USERNAME=your_username
# POWER_APPS_PASSWORD=your_password

# ============================================================================
# Optional: Supplier Registration Configuration
# ============================================================================

# Forward client's Authorization header instead of using server credentials
# Set to 'true' to use client tokens, 'false' to use server credentials
FORWARD_CLIENT_AUTH=true

# ============================================================================
# B2C Configuration (Optional - for client-side auth)
# ============================================================================

# B2C Client ID (for client-side OAuth)
VITE_B2C_CLIENT_ID=1dc49cf1-aa12-4bfb-bf9e-60ff6df8475e
# B2C Token URL
VITE_B2C_TOKEN_URL=https://login.microsoftonline.com/9bfb065d-cde3-4be3-8515-0b1c8fe6fc29/oauth2/token
# B2C Scopes
VITE_B2C_SCOPES=openid offline_access

# B2C Client Secret (DO NOT COMMIT - use environment variable instead)
# VITE_B2C_CLIENT_SECRET=your_client_secret

# ============================================================================
# Important Notes
# ============================================================================
# 1. AZURE_CLIENT_SECRET and VITE_B2C_CLIENT_SECRET should NOT be in .env
#    - Use CI/CD pipeline secrets or local environment variables instead
#    - Or use DevServerControl tool to set them at runtime
#
# 2. To get these values:
#    - Log in to Azure Portal (https://portal.azure.com)
#    - Go to Azure Active Directory
#    - Navigate to App Registrations
#    - Select your application
#    - Copy the values from the displayed screens
#
# 3. For Dataverse:
#    - The resource URL must match your Power Apps organization
#    - It must end with /.default for OAuth 2.0 v2.0
#
# 4. Testing locally:
#    - Set environment variables before running the dev server
#    - On Windows: set AZURE_CLIENT_SECRET=value && npm run dev
#    - On macOS/Linux: AZURE_CLIENT_SECRET=value npm run dev
